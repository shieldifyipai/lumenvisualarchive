# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Lấy các thông số này trong phần: Project Settings -> API trên Supabase Dashboard
# KHÔNG commit key thật vào file này — hãy đặt chúng trong .env.local (đã được
# gitignore). File .env.example chỉ giữ placeholder làm mẫu.

# URL của dự án Supabase (Ví dụ: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public Key (An toàn khi dùng ở client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key — CHỈ dùng phía server (API routes), không bao giờ expose
# ra client và không bao giờ dùng prefix NEXT_PUBLIC_. Key này bypass toàn bộ
# Row Level Security nên cấp quyền ghi/xoá trực tiếp trên database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# REST API — đăng bài / quản trị qua HTTP
# ==============================================================================
# Chuỗi bí mật dùng để xác thực các request ghi dữ liệu:
#   POST/PATCH/DELETE /api/projects  ->  header `x-api-key: <giá trị này>`
#   (hoặc `Authorization: Bearer <giá trị này>`)
# Tạo chuỗi ngẫu nhiên đủ dài, ví dụ:  node -e "console.log(crypto.randomUUID())"
# Trong production, các write endpoint trả về 503 nếu biến này chưa được đặt.
# Trong development, để trống thì API mở (chỉ cảnh báo trong console).
ADMIN_API_KEY=change-me-to-a-long-random-secret

# ==============================================================================
# TÙY CHỌN BẢN QUYỀN & THƯƠNG HIỆU
# ==============================================================================
NEXT_PUBLIC_SITE_NAME="LUMEN ARCHIVE"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
